# Copie este arquivo para ".env" (que NÃO vai para o GitHub) e preencha.

# MySQL (local ou Docker): mysql://USUARIO:SENHA@HOST:3306/BANCO
DATABASE_URL=mysql://root:SUA_SENHA@localhost:3306/sistema_agendamento
# Use true somente se o MySQL estiver em nuvem e exigir SSL
DB_SSL=false

# Segredo do login do painel (mínimo 16 caracteres). Gere um:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

PORT=3001
# Origem do front-end React (CORS). Em dev com Vite: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Regras de agendamento (decisões em aberto do grupo)
STATUS_INICIAL=CONFIRMADO      # ou PENDENTE (profissional aprova)
PASSO_MINUTOS=30               # intervalo entre horários oferecidos
ANTECEDENCIA_MINUTOS=60        # antecedência mínima para agendar hoje

# MODO_DEMO=true  -> sem banco: dados fictícios em memória (para testar o front-end)
MODO_DEMO=false
