# Copie este arquivo para ".env" (que NÃO vai para o GitHub) e preencha.
# Supabase -> botão Connect -> Direct -> Session pooler -> URI
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Segredo do login do painel. Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

PORT=3001
# Origem do front-end React (CORS). Em dev com Vite: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Regras de agendamento (decisões em aberto do grupo)
STATUS_INICIAL=CONFIRMADO      # ou PENDENTE (profissional aprova)
PASSO_MINUTOS=30               # intervalo entre horários oferecidos
ANTECEDENCIA_MINUTOS=60        # antecedência mínima para agendar hoje
